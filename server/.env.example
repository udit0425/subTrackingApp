# Copy to .env (never commit .env). Generate keys with: openssl rand -base64 32
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=mysql://st:change-me@localhost:3306/subtracker
# 32-byte base64 key for encrypting personal data at rest (AES-256-GCM)
DATA_ENCRYPTION_KEY=
# 32-byte base64 key used to hash emails for lookup (HMAC-SHA256)
EMAIL_HASH_KEY=
# Leave empty in development to print verification links to the console.
SMTP_URL=
MAIL_FROM=SubTracker <no-reply@example.com>
